{
  "name": "chgt-helpdesk",
  "version": "1.2.8",
  "description": "Central de HelpDesk local para gerenciamento de chamados e equipamentos",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:all": "node src/start.js",
    "reset-local-data": "node reset-local-data.js",
    "test": "node test/run.js",
    "smoke": "node test/run.js",
    "dns": "node src/dns-server.js",
    "dns:dev": "npx nodemon src/dns-server.js",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "dns-packet": "^5.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
